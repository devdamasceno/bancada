# Copie este arquivo para .env.local e preencha. Nunca publique o .env.local.

# Claude (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
# Opcional: troque o modelo sem mexer no código (padrão: claude-haiku-5-5, o mais econômico)
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Supabase (Project Settings > API). Sem estas duas, o site grava em data/ (só para teste local).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Área administrativa (/admin): senha de acesso (mínimo 10 caracteres). Trocar a senha desconecta todo mundo.
ADMIN_SENHA=

# Aviso por e-mail a cada pedido enviado (resend.com > API Keys)
RESEND_API_KEY=
NOTIFICAR_EMAIL=
# Remetente com domínio verificado no Resend. Sem isso, usa onboarding@resend.dev, que só entrega
# para o e-mail dono da conta Resend: o aviso para você funciona, mas o e-mail ao cliente fica desligado.
# EMAIL_REMETENTE=Kriai <contato@kriai.online>
# Opcional: endereço do site no ar, usado no link "Abrir no painel" do e-mail. Ex.: https://www.kriai.online
# SITE_URL=
